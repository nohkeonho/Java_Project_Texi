package taxi;

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import java.awt.*;
import java.awt.event.FocusAdapter;
import java.awt.event.FocusEvent;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;

public class SignupPanel extends JPanel {

    public SignupPanel(TaxiSharePrototype mainFrame) {
        setLayout(new BoxLayout(this, BoxLayout.Y_AXIS));
        setBackground(TaxiSharePrototype.BG_WHITE);
        setBorder(new EmptyBorder(25, 28, 25, 28));

        // 뒤로가기 헤더
        JLabel backBtn = UIComponents.createLabel("←  로그인으로", 13, Font.PLAIN, TaxiSharePrototype.TEXT_GRAY);
        backBtn.setAlignmentX(Component.LEFT_ALIGNMENT);
        backBtn.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        backBtn.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseClicked(MouseEvent e) {
                mainFrame.showScreen("LOGIN");
            }
        });
        add(backBtn);
        add(Box.createVerticalStrut(20));

        // 타이틀
        JLabel title = UIComponents.createLabel("회원가입", 26, Font.BOLD, TaxiSharePrototype.TEXT_DARK);
        title.setAlignmentX(Component.LEFT_ALIGNMENT);
        add(title);
        add(Box.createVerticalStrut(6));

        JLabel subtitle = UIComponents.createLabel("함께 탈 이웃에게 보여줄 정보를 알려주세요", 13, Font.PLAIN, TaxiSharePrototype.TEXT_GRAY);
        subtitle.setAlignmentX(Component.LEFT_ALIGNMENT);
        add(subtitle);
        add(Box.createVerticalStrut(22));

        // 아이디
        addFieldLabel("아이디");
        add(new UIComponents.RoundedTextField("아이디를 입력하세요"));
        add(Box.createVerticalStrut(14));

        // 비밀번호
        addFieldLabel("비밀번호");
        add(new UIComponents.RoundedTextField("비밀번호를 입력하세요"));
        add(Box.createVerticalStrut(14));

        // 성별 선택
        addFieldLabel("성별");
        JPanel genderPanel = new JPanel(new GridLayout(1, 2, 12, 0));
        genderPanel.setOpaque(false);
        genderPanel.setMaximumSize(new Dimension(350, 46));
        genderPanel.setAlignmentX(Component.LEFT_ALIGNMENT);

        JCheckBox maleCheck = createGenderBox("남성");
        JCheckBox femaleCheck = createGenderBox("여성");
        ButtonGroup genderGroup = new ButtonGroup();
        genderGroup.add(maleCheck);
        genderGroup.add(femaleCheck);

        genderPanel.add(maleCheck);
        genderPanel.add(femaleCheck);
        add(genderPanel);
        add(Box.createVerticalStrut(14));

        // 나의 동승 스타일
        addFieldLabel("나의 동승 스타일");
        JTextArea styleArea = new JTextArea("예) 조용히 갈래요, 스몰톡 해도 괜찮아요");
        styleArea.setFont(new Font("맑은 고딕", Font.PLAIN, 13));
        styleArea.setForeground(TaxiSharePrototype.TEXT_GRAY);
        styleArea.setLineWrap(true);
        styleArea.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(TaxiSharePrototype.BORDER_GRAY, 1, true),
                new EmptyBorder(10, 12, 10, 12)
        ));
        styleArea.setMaximumSize(new Dimension(350, 85));
        styleArea.setAlignmentX(Component.LEFT_ALIGNMENT);
        styleArea.addFocusListener(new FocusAdapter() {
            @Override
            public void focusGained(FocusEvent e) {
                if (styleArea.getText().startsWith("예)")) {
                    styleArea.setText("");
                    styleArea.setForeground(TaxiSharePrototype.TEXT_DARK);
                }
            }
        });
        add(styleArea);
        add(Box.createVerticalStrut(4));

        JLabel hintLabel = UIComponents.createLabel("매칭된 동승자에게 보여요 · 최대 60자", 11, Font.PLAIN, TaxiSharePrototype.TEXT_GRAY);
        hintLabel.setAlignmentX(Component.LEFT_ALIGNMENT);
        add(hintLabel);
        add(Box.createVerticalStrut(16));

        // ★ 위치정보 수집 및 활용 동의 체크박스
        JPanel locationConsentPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 6, 8));
        locationConsentPanel.setBackground(new Color(248, 249, 252));
        locationConsentPanel.setBorder(BorderFactory.createLineBorder(TaxiSharePrototype.BORDER_GRAY, 1, true));
        locationConsentPanel.setMaximumSize(new Dimension(350, 42));
        locationConsentPanel.setAlignmentX(Component.LEFT_ALIGNMENT);

        JCheckBox locationCheckBox = new JCheckBox("위치정보 수집 및 활용에 동의하시겠습니까?");
        locationCheckBox.setFont(new Font("맑은 고딕", Font.BOLD, 12));
        locationCheckBox.setForeground(TaxiSharePrototype.TEXT_DARK);
        locationCheckBox.setOpaque(false);
        locationCheckBox.setFocusPainted(false);
        locationConsentPanel.add(locationCheckBox);

        add(locationConsentPanel);
        add(Box.createVerticalGlue());

        // 가입하기 버튼
        UIComponents.RoundedButton submitBtn = new UIComponents.RoundedButton("가입하기", TaxiSharePrototype.PRIMARY_BLUE, Color.WHITE);
        submitBtn.addActionListener(e -> {
            if (!locationCheckBox.isSelected()) {
                JOptionPane.showMessageDialog(this,
                        "위치정보 수집 및 활용에 동의해야 가입이 가능합니다.",
                        "필수 동의 안내",
                        JOptionPane.WARNING_MESSAGE);
                return;
            }
            JOptionPane.showMessageDialog(this, "회원가입이 완료되었습니다!");
            mainFrame.showScreen("CALL");
        });
        add(submitBtn);
    }

    private void addFieldLabel(String text) {
        JLabel lbl = UIComponents.createLabel(text, 13, Font.BOLD, TaxiSharePrototype.TEXT_GRAY);
        lbl.setAlignmentX(Component.LEFT_ALIGNMENT);
        add(lbl);
        add(Box.createVerticalStrut(6));
    }

    private JCheckBox createGenderBox(String text) {
        JCheckBox box = new JCheckBox(text);
        box.setFont(new Font("맑은 고딕", Font.PLAIN, 14));
        box.setForeground(TaxiSharePrototype.TEXT_DARK);
        box.setBackground(TaxiSharePrototype.BG_WHITE);
        box.setHorizontalAlignment(SwingConstants.CENTER);
        box.setFocusPainted(false);
        box.setBorder(BorderFactory.createLineBorder(TaxiSharePrototype.BORDER_GRAY, 1, true));
        box.setBorderPainted(true);
        return box;
    }
}

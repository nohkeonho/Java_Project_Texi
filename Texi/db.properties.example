# 이 파일을 복사해서 "db.properties" 라는 이름으로 만든 뒤, 본인 값으로 바꿔 주세요.
# (db.properties 는 비밀번호가 들어 있으므로 GitHub에 올리지 마세요!)

# serverTimezone : 시간이 9시간씩 틀어지는 문제를 막기 위해 한국 시간으로 지정
# allowPublicKeyRetrieval : MySQL 8 의 기본 로그인 방식에서 "Public Key Retrieval" 오류가 날 때 필요
db.url=jdbc:mysql://localhost:3306/taxi_share?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
db.user=root
db.password=여기에_본인_MySQL_비밀번호
